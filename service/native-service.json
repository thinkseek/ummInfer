{
  "name": "umminfer-native-service",
  "run_dir": "/opt/umminfer/native-service/run",
  "log_dir": "/opt/umminfer/native-service/logs",
  "ipc_dir": "/tmp/umminfer-native-ipc",
  "host": "127.0.0.1",
  "port": 43301,
  "binary": "/opt/umminfer/native-service/bin/umm-infer",
  "stage_binary_dir": "/opt/umminfer/native-service/bin",
  "model": "qwen3-native",
  "vlm_stage": "qwen38",
  "native_stages": [
    {
      "name": "asr",
      "model": "/opt/umminfer/models/asr",
      "gpu": 2
    },
    {
      "name": "qwen38",
      "kind": "qwen38",
      "model": "/opt/umminfer/models/qwen3.8-27b",
      "gpu": 3,
      "args": ["--max-new-tokens", "96", "--batch-size", "8"]
    },
    {
      "name": "image",
      "model": "/opt/umminfer/models/Qwen-Image-2512",
      "gpu": 4
    },
    {
      "name": "tts",
      "model": "/opt/umminfer/models/qwen3-tts",
      "gpu": 5
    }
  ],
  "optional_stages": [
    {
      "name": "omni",
      "kind": "omni",
      "model": "/opt/umminfer/models/omni",
      "gpu": 3,
      "args": ["--max-new-tokens", "96"]
    },
    {
      "name": "flux2",
      "kind": "flux2",
      "model": "/opt/umminfer/models/FLUX.2-klein-4B",
      "gpu": 6,
      "args": ["--backend", "diffusers", "--default-steps", "4",
               "--default-size", "1024x1024"],
      "launcher": "python/umminfer_flux2_stage.py"
    },
    {
      "name": "video",
      "kind": "video",
      "model": "/opt/umminfer/models/Wan2.2-TI2V-5B-Diffusers",
      "gpu": 7,
      "args": ["--backend", "diffusers", "--default-seconds", "2"],
      "launcher": "python/umminfer_video_stage.py"
    },
    {
      "name": "video-native",
      "kind": "video",
      "model": "/opt/umminfer/models/Wan2.2-TI2V-5B-Diffusers",
      "gpu": 6,
      "args": ["--video-backend", "cuda", "--size", "704x480",
               "--fps", "16", "--steps", "15"]
    },
    {
      "name": "tts-base",
      "kind": "tts",
      "model": "/opt/umminfer/models/Qwen3-TTS-12Hz-1.7B-Base",
      "gpu": 5
    }
  ],
  "env": {
    "LD_LIBRARY_PATH": "/opt/umminfer/deps/lib:/opt/umminfer/curl-prefix/lib"
  },
  "health_path": "/health",
  "ready_path": "/ready",
  "ready_grace_s": 180,
  "ready_failures": 5,
  "health_interval_s": 2,
  "health_grace_s": 8,
  "health_failures": 3,
  "stop_grace_s": 10,
  "backoff_s": [1, 2, 4, 8, 15, 30],
  "stable_s": 60
}
